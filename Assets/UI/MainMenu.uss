/* 强制覆盖 UnityDefaultRuntimeTheme 的默认字体（TextCore FontAsset） */
.root, .title, .textBtn {
    -unity-font-definition: resource("Fonts/Pixel SDF");
}

/* 全屏根节点 */
.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 全屏背景：脚本注入 backgroundImage */
.bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    /* 旧版 UI Toolkit 常用背景缩放模式 */
    -unity-background-scale-mode: scale-and-crop;
}

/* 主布局层：垂直排布，居中对齐 */
.layout {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    flex-direction: column;
    align-items: center;
}

/* 上下弹簧：让 hero 落在屏幕中轴线附近 */
.spacer {
    flex-grow: 1;
}

/* 中轴线的图片容器（脚本注入 backgroundImage） */
.hero {
    width: 560px;
    height: 240px;

    align-items: center;
    justify-content: center;

    -unity-background-scale-mode: scale-to-fit;
}

/* 图片正中央标题：放大约 3 倍（你可按需要再微调） */
.title {
    -unity-font-style: bold;
    font-size: 100px; /* 原 56 -> 168 */
    color: rgb(255, 255, 255);
    unity-text-align: middle-center;
}

/* 按钮容器：纵向排列，位于 hero 下方 */
.buttons {
    flex-direction: column;
    align-items: center;
    justify-content: center;

    margin-top: 48px;
}

/* 纯文字按钮：彻底去掉按钮图片/底色/边框，仅显示文字 */
.textBtn {
    /* 去掉按钮底（包括主题可能带的背景图 tint） */
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);

    /* 去边框 */
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    /* 去圆角（避免主题残留） */
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;

    /* 保留点击区域 */
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;

    /* 两个按钮之间留间距 */
    margin-top: 12px;
    margin-bottom: 12px;

    /* 按钮文字放大约 3 倍（原 30 -> 90） */
    font-size: 90px;
    color: rgb(255, 255, 255);
    unity-text-align: middle-center;
}
