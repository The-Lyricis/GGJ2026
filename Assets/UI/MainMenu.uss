/* 强制覆盖 UnityDefaultRuntimeTheme 的默认字体（TextCore FontAsset） */
.root, .title, .textBtn {
    -unity-font-definition: resource("Fonts/Pixel SDF");
}

/* 全屏根节点 */
.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 全屏背景：脚本注入 backgroundImage */
.bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    -unity-background-scale-mode: scale-and-crop;
}

/* 主布局层：垂直排布，居中对齐 */
.layout {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    flex-direction: column;
    align-items: center;
}

/* 上下弹簧 */
.spacer {
    flex-grow: 1;
}

/* =========================
   顶部图片（与标题分离）
   ========================= */
.topArt {
    width: 560px;
    height: 240px;

    margin-bottom: 12px;

    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);
}

/* 标题：独立显示，不再压在图片上 */
.title {
    -unity-font-style: bold;
    font-size: 100px;
    color: rgb(255, 255, 255);
    unity-text-align: middle-center;

    margin-bottom: 28px;
}

/* =========================
   按钮区：按钮必须在中轴线居中
   ========================= */

/*
  核心思路：
  - buttonSection 是相对定位容器，宽度拉满
  - buttonsAnchor 用 absolute + left:50% + translate(-btnW/2) 锚定到屏幕中心
  - sideArt 同样 absolute，位置 = 按钮左边缘 - gap - 自身宽度
*/
.buttonSection {
    position: relative;
    width: 100%;

    /* 给按钮区一些高度，避免元素互相挤压（按你的画面可微调） */
    min-height: 260px;
}

/* 你可以把以下“常量”当作参数来改 */
.buttonSection {
    /* 按钮列固定宽度（关键：保证按钮“居中”可计算） */
    --btnW: 420px;

    /* 左侧图片宽度 */
    --artW: 220px;

    /* 图片与按钮间距 */
    --gap: 36px;
}

/* 按钮列：纵向排列，且固定宽度 */
.buttonsAnchor {
    position: absolute;
    left: 50%;
    top: 0;

    width: var(--btnW);

    flex-direction: column;
    align-items: center;
    justify-content: center;

    /* 锚定在中心线：-btnW/2 = -210px（对应 --btnW:420px） */
    translate: -210px 0;
}

/* 左侧图片：放在按钮列左侧，但不影响按钮居中 */
.sideArt {
    position: absolute;
    left: 50%;
    top: 0;

    width: var(--artW);
    height: var(--artW);

    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);

    /*
      sideArt 的目标位置：
      以中心线为参照，向左移动：btnW/2 + gap + artW
      = 210 + 36 + 220 = 466px
    */
    translate: -466px 0;
}

/* 纯文字按钮：彻底去掉按钮图片/底色/边框，仅显示文字 */
.textBtn {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;

    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;

    margin-top: 12px;
    margin-bottom: 12px;

    font-size: 90px;
    color: rgb(255, 255, 255);
    unity-text-align: middle-center;
}
