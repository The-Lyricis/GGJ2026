<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="MainMenu.uss" />

    <ui:VisualElement name="root" class="root">
        <!-- 全屏背景（脚本设置 sprite） -->
        <ui:VisualElement name="bg" class="bg" />

        <!-- 垂直布局：上弹簧 / 中间hero / 按钮 / 下弹簧 -->
        <ui:VisualElement name="layout" class="layout">
            <ui:VisualElement class="spacer" />

            <!-- 中轴线：图片 + 标题（都在 hero 内，保证居中） -->
            <ui:VisualElement name="hero" class="hero">
                <ui:Label name="title" class="title" text="Oops, All Me" />
            </ui:VisualElement>

            <!-- 按钮（纵向） -->
            <ui:VisualElement name="buttons" class="buttons">
                <ui:Button name="btnStart" class="textBtn" text="start" />
                <ui:Button name="btnExit" class="textBtn" text="exit" />
            </ui:VisualElement>

            <ui:VisualElement class="spacer" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
